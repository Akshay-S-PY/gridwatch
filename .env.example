# Database
DATABASE_URL=postgresql://gridwatch:gridwatch@db:5432/gridwatch

# Qdrant
QDRANT_HOST=qdrant
QDRANT_PORT=6333

# LLM provider — the llm/ wrapper selects one of these.
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o
EMBED_MODEL=text-embedding-3-small
OPENAI_API_KEY=your_key_here
ANTHROPIC_API_KEY=your_key_here

# Open-Meteo (no key needed)
WEATHER_LAT=51.5074
WEATHER_LON=-0.1278

# Slack (optional - for anomaly alerts)
SLACK_WEBHOOK_URL=

# App
LOG_LEVEL=INFO
ENVIRONMENT=development
